    {
      "direction": "response",
      "validator": "ScanStatisticsResponseSchema",
      "operations": ["GET /v1/dashboard/scan-statistics"],
      "schema": {
        "properties": {
          "total_scans": {
            "type": "integer",
            "minimum": 0,
            "title": "Total Scans",
            "description": "Total number of scans"
          },
          "targets_scanned": {
            "type": "integer",
            "minimum": 0,
            "title": "Targets Scanned",
            "description": "Number of unique targets scanned"
          },
          "targets_scanned_by_type": {
            "items": {
              "properties": {
                "name": {
                  "type": "string",
                  "title": "Name",
                  "description": "Name of the item (e.g., target type, status)"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "title": "Count",
                  "description": "Count of items"
                }
              },
              "type": "object",
              "required": ["name", "count"],
              "title": "CountByNameSchema",
              "description": "Generic count schema with name field for extensible list structures.\n\nUsed in dashboard and other endpoints to provide counts grouped by a name field.\nFrontend-friendly list format for easy iteration.\n"
            },
            "type": "array",
            "title": "Targets Scanned By Type",
            "description": "Targets scanned grouped by type (APPLICATION, AGENT, MODEL)"
          },
          "scan_status": {
            "items": {
              "$ref": "#/properties/targets_scanned_by_type/items"
            },
            "type": "array",
            "title": "Scan Status",
            "description": "Scan counts by status (COMPLETED, IN_PROGRESS, QUEUED, FAILED)"
          },
          "risk_profile": {
            "items": {
              "properties": {
                "risk_rating": {
                  "description": "Risk rating level based on job score",
                  "type": "string",
                  "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
                  "title": "RiskRating"
                },
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "title": "Total",
                  "description": "Total count for this risk rating level"
                },
                "targets_by_type": {
                  "items": {
                    "$ref": "#/properties/targets_scanned_by_type/items"
                  },
                  "type": "array",
                  "title": "Targets By Type",
                  "description": "Breakdown by target type (APPLICATION, AGENT, MODEL)"
                }
              },
              "type": "object",
              "required": ["risk_rating", "total"],
              "title": "RiskLevelSchema",
              "description": "Risk level breakdown with risk rating and target type counts."
            },
            "type": "array",
            "title": "Risk Profile",
            "description": "Risk breakdown by severity level with target type details"
          }
        },
        "type": "object",
        "required": ["total_scans", "targets_scanned"],
        "title": "ScanStatisticsResponseSchema",
        "description": "Dashboard scan statistics response.\n\nEndpoint: GET /api/v1/dashboard/scan-statistics\nReturns scan counts, target stats, and risk profile in list format.\n"
      }
    },
    {
