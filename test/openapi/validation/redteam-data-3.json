          }
        },
        "type": "object",
        "required": ["labels", "series"],
        "title": "ScoreTrendResponseSchema",
        "description": "Response for score trend chart API.\n\nEndpoint: GET /api/v1/dashboard/score-trend\nReturns time-series risk scores grouped by job type for chart display.\n"
      }
    },
